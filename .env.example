# vm-manager settings. Copy to .env for local runs; never commit .env.
# Names and defaults match the backend's infra/docker-compose.yml.

# --- required ---
DATABASE_URL=postgres://vm_manager:change-me@postgres:5432/vm_manager?sslmode=disable
# Shared secret the backend sends in gRPC metadata `x-internal-secret` (>= 32 chars).
VM_INTERNAL_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- service ---
GRPC_ADDR=:9090
LOG_LEVEL=info

# --- agent image ---
AGENT_IMAGE=personal-agent/agent:dev
# Change this to roll out a new image: stopped containers are re-created on their next wake.
AGENT_IMAGE_VERSION=dev

# --- container spec ---
SANDBOX_NETWORK=personal-agent_sandbox
SANDBOX_RUNTIME=runsc
SANDBOX_MEMORY_MB=600
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=256
SANDBOX_VOLUME_DRIVER=local
# Driver options for the /data volume, e.g. a size quota with a driver that supports it.
SANDBOX_VOLUME_OPTS=
SANDBOX_AGENT_UID=10001
BRIDGE_PORT=8765

# --- Scout's browser (a Max-plan feature; CreateSandbox.browser_enabled / SetBrowser) ---
# A container with the browser turned on gets these limits instead of SANDBOX_MEMORY_MB and
# SANDBOX_PIDS_LIMIT: a headless Chromium needs far more memory, processes and threads than the
# agent alone. Neither may be below the value for the other containers. One browser container can
# take the room of three others: count it that way when you set AWAKE_CAP.
SANDBOX_BROWSER_MEMORY_MB=2048
SANDBOX_BROWSER_PIDS_LIMIT=1024

# --- what the containers talk to (always through the egress proxy) ---
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MODEL=agent-default
PLATFORM_MCP_URL=http://api:8080/mcp
EGRESS_PROXY_URL=http://172.30.0.2:3128

# --- egress allowlists (Squid) ---
EGRESS_ALLOWLIST_DIR=/allowlists
EGRESS_PROXY_CONTAINER=egress-proxy
EGRESS_RELOAD_MIN_INTERVAL=1s

# --- Claude Code runtime (the user's own Claude plan) ---
# Hosts added to a user's egress file while their runtime is claude_code or a Claude sign-in /
# sign-out is running (code.claude.com/docs/en/network-config).
CLAUDE_EGRESS_DOMAINS=api.anthropic.com,claude.ai,claude.com,platform.claude.com
# A pending Claude sign-in keeps the sandbox awake this long (the Bridge expires it after 10 minutes).
CLAUDE_LOGIN_TTL=10m

# --- capacity and loops ---
AWAKE_CAP=20
IDLE_TIMEOUT=3m
REAPER_INTERVAL=1m
HEALTH_INTERVAL=30s
HEALTH_FAILURES_BEFORE_RESTART=2
HEALTH_MAX_RESTARTS=3
RECONCILE_INTERVAL=5m
DELIVER_TIMEOUT=15m
SHUTDOWN_GRACE=20s
WAKE_TIMEOUT=90s

# --- backups ---
SNAPSHOT_ROOT=/backups

# Docker connection (read by the Docker SDK): defaults to the local socket.
# DOCKER_HOST=unix:///var/run/docker.sock
